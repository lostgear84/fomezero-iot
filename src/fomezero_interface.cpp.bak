#include "fomezero_interface.h"
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <math.h>

#define OLED_LARGURA 128
#define OLED_ALTURA 64
#define OLED_ENDERECO 0x3C
#define PINO_SDA 21
#define PINO_SCL 22

static Adafruit_SSD1306 display(OLED_LARGURA, OLED_ALTURA, &Wire, -1);
static bool displayPronto = false;

namespace InterfaceFomezero {

void iniciar() {
  Wire.begin(PINO_SDA, PINO_SCL);

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ENDERECO)) {
    Serial.println("[OLED] falha ao inicializar o display");
    displayPronto = false;
    return;
  }

  displayPronto = true;
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.println("FOMEZERO IoT");
  display.display();

  Serial.println("[OLED] display inicializado");
}

void atualizar(
  float tempC,
  float umidPct,
  float distCm,
  bool caixaPresente,
  bool emAlerta,
  bool wifiConectado,
  bool mqttConectado,
  unsigned long inicioAcima,
  unsigned long inicioAbaixo,
  unsigned long confirmaAlertaMs,
  unsigned long confirmaNormalMs
) {
  if (!displayPronto) return;

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);

  display.setCursor(0, 0);
  display.println("FOMEZERO IoT");

  display.setCursor(0, 12);
  display.printf("Temp: %s C",
    isnan(tempC) ? "--" : String(tempC, 1).c_str());

  display.setCursor(0, 22);
  display.printf("Umid: %s %%",
    isnan(umidPct) ? "--" : String(umidPct, 1).c_str());

  display.setCursor(0, 32);
  display.printf("Dist: %s cm",
    isnan(distCm) ? "--" : String(distCm, 1).c_str());

  display.setCursor(0, 42);
  display.printf("Caixa: %s",
    caixaPresente ? "PRESENTE" : "AUSENTE");

  display.setCursor(0, 52);
  display.printf("WiFi:%s MQTT:%s",
    wifiConectado ? "OK" : "--",
    mqttConectado ? "OK" : "--");

  if (emAlerta) {
    display.setCursor(0, 56);
    display.setTextColor(SSD1306_WHITE, SSD1306_BLACK);
    display.println("ALERTA: CADEIA DE FRIO");
  }

  display.display();
}

}
