    {
      "id": 10,
      "type": "table",
      "title": "Historico de eventos termicos",
      "datasource": {
        "type": "influxdb",
        "uid": "fomezero-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "fomezero-influx"
          },
          "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alertas\" and r.lote_id == \"LOTE-2026-0001\")\n  |> filter(fn: (r) => contains(value: r._field, set: [\"temp_c\",\"estado\",\"evento\"]))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"_time\",\"device_id\",\"temp_c\",\"estado\",\"evento\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 50)"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
