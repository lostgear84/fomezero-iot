    {
      "id": 2,
      "title": "Temperatura - ultima amostra",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "fomezero-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "fomezero-influx"
          },
          "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetria\")\n  |> filter(fn: (r) => r.lote_id == \"LOTE-2026-0001\")\n  |> filter(fn: (r) => r._field == \"temp_c\")\n  |> last()\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "mappings": [],
